# Copy to .env and adjust. Loaded by dotenv-rails in development and test.

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=mini_twitter_development
TEST_DATABASE_NAME=mini_twitter_test

# --- Web ---
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
