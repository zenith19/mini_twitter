source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby '3.2.3'

gem 'rails', '~> 7.1.5'
gem 'pg', '~> 1.5'
gem 'puma', '~> 6.4'

# Boot-time cache for the Ruby/Rails load path.
gem 'bootsnap', '>= 1.18', require: false

# NOTE: these four used to sit in `group :development`, which meant
# Bundler.require never loaded them in test or production and the app
# could not boot outside development. They belong at the top level.
gem 'devise', '~> 4.9'          # password hashing + validations only
gem 'bcrypt', '~> 3.1'
gem 'rack-cors', '~> 2.0'
gem 'active_model_serializers', '~> 0.10.14'

# Pagination for the index endpoints.
gem 'kaminari', '~> 1.2'

# Throttling, notably on the login endpoint.
gem 'rack-attack', '~> 6.7'

gem 'tzinfo-data', platforms: %i[windows jruby]

# Used only by db/seeds.rb, but kept out of the development group so the
# demo deployment can seed itself — Render installs with
# BUNDLE_WITHOUT=development:test.
gem 'faker', '~> 3.8'

group :development, :test do
  gem 'debug', platforms: %i[mri windows]
  # Rails 7.1's test runner is not compatible with minitest 6, which changed
  # the signature of Minitest::Runnable.run.
  gem 'minitest', '~> 5.25'
  gem 'dotenv-rails'
end

group :development do
  gem 'listen', '~> 3.8'
end
